{
  "mcpServers": {
    "exa-search": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "exa-multi-mcp"],
      "env": {
        "EXA_API_KEYS": "!api-vault get exa --json | jq -r '.key | if type==\"array\" then join(\",\") else . end'"
      },
      "lifecycle": "eager"
    },
    "kandev": {
      "transport": "streamable-http",
      "url": "http://localhost:41006/mcp",
      "lifecycle": "eager"
    }
  }
}
