node_modules/
dist/
*.tsbuildinfo
.env
.env.*
*.local
coverage/
.DS_Store
# 剧目只有 plays/demo 这个样例进 git。用户自己玩的、临时试验跑冒烟的、mock 生成的
# 一概不进——play.json 与 assets/ 是内容不是引擎结构，留在本机即可（要带走就导出剧目包）。
plays/*/
!plays/demo/
# 样例剧目的运行时数据照样不进 git：存档即一棵独立故事树，外加 active.json 指针
plays/*/saves/
plays/*/active.json
media-cache/
# 剧目记忆运行时层（D7：always/index 手工层进 git，纪元产物与切片不进）
plays/*/memory/index/arcs/
plays/*/memory/archive/
# 工坊 meta-chat 线程（运行时会话，不进 git）
plays/*/workshop/
# soak 报告（scripts/soak.mjs 的跑批产物，留档回看用，不进 git）
plays/*/soak/
.mnemon/
.worktrees/

# 本地验收截图
.shots/
# playwright-cli 会话产物
.playwright-cli/
# 素材管线的跑批产物（scripts/gen_*.py 的输出）不是仓库内容，跑一遍就有。
# 前导斜杠必须留着：不锚在仓库根的话这条会连 plays/demo/assets/ 一起吃掉
/assets/
# Python 字节码
__pycache__/
