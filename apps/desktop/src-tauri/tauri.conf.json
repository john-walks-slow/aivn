{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIVN",
  "version": "0.3.2",
  "identifier": "io.github.johnwalksslow.aivn",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIVN",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "backgroundColor": "#17130f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "john-walks-slow",
    "copyright": "MIT licensed",
    "category": "Game",
    "shortDescription": "AI visual novel engine",
    "longDescription": "AIVN — an LLM playwriter streams an incremental Stage DSL script and the window renders it like streaming video.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/aivn-server"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
